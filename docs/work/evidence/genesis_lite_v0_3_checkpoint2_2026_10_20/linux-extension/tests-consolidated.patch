+"""Test-only stdlib probe, sent on stdin to a development container/namespace.
+
+No formal data. Canary writes require an explicit test-container argument.
+Every mount is retained, including pseudo-filesystems and failed probes.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import socket
+import sys
+
+
+def decode(value):
+    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), value)
+
+
+def probe(config):
+    raw = Path("/proc/self/mountinfo").read_text()
+    mounts = []
+    for line in raw.splitlines():
+        left, right = line.split(" - ", 1)
+        fields, fs = left.split(), right.split()
+        row = dict(id=fields[0], parent=fields[1], device=fields[2],
+                   root=decode(fields[3]), target=decode(fields[4]),
+                   options=fields[5].split(","), optional=fields[6:],
+                   fstype=fs[0], source=decode(fs[1]), super_options=fs[2].split(","))
+        row["canary"] = "READ_ONLY" if "ro" in row["options"] else "NOT_PROBED"
+        if "rw" in row["options"] and config.get("write_canaries"):
+            # Never read/write device endpoints or pseudo-files. Report them as
+            # unprobeable, rather than silently excluding them from the inventory.
+            target = Path(row["target"])
+            if row["fstype"] not in ("tmpfs", "overlay", "ext4") or not target.is_dir():
+                row["canary"] = "UNPROBEABLE"
+            else:
+                marker = target / config["marker"]
+                try:
+                    row["seen"] = marker.read_bytes().hex() if marker.exists() else None
+                    marker.write_bytes(bytes.fromhex(config["token"]))
+                    row["canary"] = "WRITTEN"
+                except OSError as exc:
+                    row["canary"] = "UNPROBEABLE"
+                    row["error"] = type(exc).__name__
+        mounts.append(row)
+    status = dict(line.split(":", 1) for line in Path("/proc/self/status").read_text().splitlines()
+                  if ":" in line)
+    writes = {}
+    for name, filename in config.get("read_only_files", {}).items():
+        try:
+            fd = os.open(filename, os.O_WRONLY)  # no truncate, append or actual write
+            os.close(fd)
+            writes[name] = "WRITABLE"
+        except OSError as exc:
+            writes[name] = type(exc).__name__
+    network = {}
+    for label, address in config.get("network_targets", {}).items():
+        try:
+            with socket.create_connection(tuple(address), timeout=0.2):
+                network[label] = "REACHED"
+        except OSError as exc:
+            network[label] = type(exc).__name__
+    paths = {}
+    for name in ("HOME", "TMPDIR", "XDG_CACHE_HOME", "PYTHONPYCACHEPREFIX"):
+        path = os.environ.get(name)
+        paths[name] = path
+        if path and config.get("write_canaries"):
+            Path(path).mkdir(parents=True, exist_ok=True)
+            marker = Path(path) / ("env-" + name + "-" + config["marker"])
+            paths[name + "_seen"] = marker.read_bytes().hex() if marker.exists() else None
+            marker.write_bytes(bytes.fromhex(config["token"]))
+    containerenv = Path("/run/.containerenv").read_text() if Path("/run/.containerenv").exists() else ""
+    identity = re.search(r'^id="([^"]+)"', containerenv, re.MULTILINE)
+    return dict(mountinfo=raw, mounts=mounts, status=status, writes=writes,
+                container_id=identity[1] if identity else None, containerenv=containerenv,
+                network=network, interfaces=sorted(p.name for p in Path("/sys/class/net").iterdir()),
+                environment=paths, cwd=os.getcwd(), uid=os.getuid(),
+                machine=socket.gethostname())
+
+
+if __name__ == "__main__":
+    print(json.dumps(probe(json.loads(sys.argv[1])), sort_keys=True))
