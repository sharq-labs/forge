+"""Checkpoint-2 Linux counterexamples; no production implementation.
+
+The Podman fixture is a test rig, NOT the formal launcher. Passing controls
+qualify the test rig only. Red assertions below exercise current production
+launcher/verifier behavior. Captured raw output is preserved for review.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import secrets
+import shutil
+import socket
+import subprocess
+import sys
+
+import pytest
+
+from benchmarks.genesis_lite.v0_3 import deployment_attacks as attacks
+from benchmarks.genesis_lite.v0_3 import isolation
+
+IMAGE = "localhost/forge-card@sha256:89847920916e46363fe52f7cecc3a2b937d34d6b355dd3e8cc14527fe65a8261"
+ROOT = Path(__file__).resolve().parents[2]
+PROBE = Path(__file__).with_name("container_isolation_probe.py")
+pytestmark = pytest.mark.skipif(sys.platform != "linux", reason="real Linux container observations required")
+
+
+@pytest.fixture(scope="module")
+def rig(tmp_path_factory):
+    if not shutil.which("podman"):
+        pytest.skip("RUNTIME_UNAVAILABLE: Podman prerequisite; not a scientific failure")
+    inspected_image = subprocess.run(["podman", "image", "inspect", IMAGE], capture_output=True, text=True)
+    if inspected_image.returncode:
+        pytest.skip("RUNTIME_UNAVAILABLE: pinned local image absent: " + inspected_image.stderr)
+    image_inspection = json.loads(inspected_image.stdout)[0]
+    assert image_inspection["Digest"] == IMAGE.split("@")[1]
+    directory = tmp_path_factory.mktemp("container-cp2")
+    transcripts = []
+    source_sha = subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip()
+    assert source_sha == os.environ["FORGE_CHECKPOINT_SOURCE_SHA"]
+    rootless = subprocess.check_output(["podman", "info", "--format", "{{.Host.Security.Rootless}}"],
+                                      text=True).strip()
+    assert rootless == "true"
+    metadata = dict(source_sha=source_sha, rootless=rootless, python=sys.version,
+                    test_sha256={p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in (
+                        Path(__file__), Path(__file__).with_name("test_genesis_lite_v0_3_container_isolation.py"))},
+                    image=IMAGE, podman=subprocess.check_output(["podman", "--version"], text=True).strip(),
+                    probe_sha256=hashlib.sha256(PROBE.read_bytes()).hexdigest(),
+                    launcher_sha256=hashlib.sha256(Path(isolation.__file__).read_bytes()).hexdigest(),
+                    image_inspection=image_inspection, containerfile_sha256=hashlib.sha256(
+                        Path("/home/dev_kaeem/forge-card/Containerfile").read_bytes()).hexdigest())
+    server = socket.socket()
+    server.bind(("127.0.0.1", 0))
+    server.listen(8)
+    metadata["host_listener"] = server.getsockname()
+    with socket.create_connection(server.getsockname(), timeout=1):
+        pass  # listener positive control on host
+    shared = directory / "shared"
+    shared.mkdir()
+    marker, token = "cp2-" + secrets.token_hex(12), secrets.token_hex(32)
+
+    def run(shared_volume=False, image=IMAGE):
+        cidfile = directory / (secrets.token_hex(8) + ".cid")
+        argv = ["podman", "create", "--pull=never", "--rm", "--read-only", "--network=none",
+                "--cap-drop=ALL", "--security-opt=no-new-privileges", "--userns=keep-id",
+                "--cidfile", str(cidfile), "-i"]
+        for target in ("/tmp", "/var/tmp", "/run", "/dev/shm"):
+            argv += ["--tmpfs", target + ":rw,nosuid,nodev,mode=1777"]
+        argv += ["--volume", f"{ROOT}:/source:ro", "--volume", f"{sys.prefix}:/venv:ro",
+                 "--workdir", "/tmp", "--env", "HOME=/tmp/home", "--env", "TMPDIR=/tmp",
+                 "--env", "XDG_CACHE_HOME=/tmp/cache", "--env", "PYTHONPYCACHEPREFIX=/tmp/pycache"]
+        if shared_volume:
+            argv += ["--volume", f"{shared}:/shared:rw"]
+        config = dict(write_canaries=True, marker=marker, token=token,
+                      read_only_files=dict(source="/source/benchmarks/genesis_lite/v0_3/isolation.py",
+                                           venv="/venv/pyvenv.cfg"),
+                      network_targets=dict(host_listener=server.getsockname(), external=("192.0.2.1", 9)))
+        argv += [image, "python3", "-", json.dumps(config)]
+        created = subprocess.run(argv, text=True, capture_output=True, timeout=30)
+        cid = created.stdout.strip() if created.returncode == 0 else None
+        inspect = subprocess.run(["podman", "inspect", cid], text=True, capture_output=True,
+                                 timeout=10) if cid else None
+        start = ["podman", "start", "--attach", "--interactive", cid] if cid else None
+        done = subprocess.run(start, input=PROBE.read_text(), text=True, capture_output=True,
+                              timeout=30) if cid else created
+        record = dict(argv=argv, config=config, cid=cid, returncode=done.returncode,
+                      start_argv=start, create_stdout=created.stdout, create_stderr=created.stderr,
+                      inspect=json.loads(inspect.stdout) if inspect and inspect.returncode == 0 else None,
+                      stdout=done.stdout, stderr=done.stderr)
+        transcripts.append(record)
+        if done.returncode:
+            return record, None
+        report = json.loads(done.stdout)
+        assert cid and record["inspect"], "runtime did not expose a container identity"
+        assert record["inspect"][0]["Id"] == cid
+        assert record["inspect"][0]["ImageDigest"] == image_inspection["Digest"]
+        assert record["inspect"][0]["Image"] == image_inspection["Id"].removeprefix("sha256:")
+        assert report["machine"] == cid[:12]
+        # --rm must have destroyed the identity; restart is attempted for each card.
+        restart = subprocess.run(["podman", "start", cid], capture_output=True, text=True, timeout=10)
+        record["restart"] = dict(returncode=restart.returncode, stdout=restart.stdout, stderr=restart.stderr)
+        return record, report
+
+    yield run, transcripts, metadata
+    server.close()
+    destination = Path(os.environ["FORGE_CHECKPOINT_EVIDENCE"])
+    destination.mkdir(parents=True, exist_ok=True)
+    (destination / "runtime.json").write_bytes(
+        (json.dumps(dict(metadata=metadata, transcripts=transcripts), indent=2, sort_keys=True) + "\n").encode())
+
+
+@pytest.fixture(scope="module")
+def observations(rig):
+    run, _, _ = rig
+    results = [run(), run(), run(), run(shared_volume=True), run(shared_volume=True)]
+    assert all(record["returncode"] == 0 and report for record, report in results), results
+    return results
+
+
+def test_real_kernel_security_controls(observations):
+    for record, report in observations:
+        assert report["interfaces"] == ["lo"]
+        assert all(value != "REACHED" for value in report["network"].values())
+        assert all(int(report["status"][key].strip(), 16) == 0
+                   for key in ("CapInh", "CapPrm", "CapEff", "CapBnd", "CapAmb"))
+        assert report["status"]["NoNewPrivs"].strip() == "1"
+        assert report["writes"] == {"source": "OSError", "venv": "OSError"}
+        assert record["restart"]["returncode"] != 0
+
+
+def test_real_card_identities_and_private_home_cache(observations):
+    assert len({r["cid"] for r, _ in observations}) == len(observations)
+    for _, report in observations[:3]:
+        assert report["cwd"] == "/tmp"
+        for key in ("HOME", "TMPDIR", "XDG_CACHE_HOME", "PYTHONPYCACHEPREFIX"):
+            assert report["environment"][key].startswith("/tmp")
+            assert report["environment"][key + "_seen"] is None
+
+
+def test_real_inventory_reconciles_runtime_declared_mounts(observations):
+    """Keep every raw mount; reconcile Podman's actual binds and tmpfs targets.
+    Remaining kernel mounts are retained for the unprobeable rejection test.
+    """
+    for record, report in observations:
+        rows = report["mounts"]
+        assert len({row["id"] for row in rows}) == len(rows)
+        assert len(rows) == len(report["mountinfo"].splitlines())
+        for mount in record["inspect"][0]["Mounts"]:
+            row = next(row for row in rows if row["target"] == mount["Destination"])
+            assert ("rw" in row["options"]) == mount["RW"]
+            assert mount["Propagation"] == "rprivate"
+        for target in ("/tmp", "/var/tmp", "/run", "/dev/shm"):
+            row = next(row for row in rows if row["target"] == target)
+            assert row["fstype"] == "tmpfs" and "rw" in row["options"]
+            assert not any(option.startswith(("shared:", "master:")) for option in row["optional"])
+
+
+def test_real_all_mount_canaries_and_shared_volume_positive_control(observations):
+    for _, report in observations[:3]:
+        assert len(report["mounts"]) == len(report["mountinfo"].splitlines())
+        assert all(row.get("seen") is None for row in report["mounts"])
+        for target in ("/tmp", "/var/tmp", "/run", "/dev/shm"):
+            assert any(row["target"] == target and row["canary"] == "WRITTEN" for row in report["mounts"])
+    _, second_shared = observations[4]
+    shared = next(row for row in second_shared["mounts"] if row["target"] == "/shared")
+    assert shared["seen"] == observations[3][0]["config"]["token"]
+
+
+def _verdict(report):
+    # Current public verifier consumes only rationale strings. Preserve raw
+    # evidence in its detail field instead of pretending a new API exists.
+    return attacks.verify_deployment(
+        lambda spec: [spec.rsplit(":", 1)[1] + ":REFUSED:" + json.dumps(report)],
+        scan_findings=[],
+    )
+
+
+def test_real_unprobeable_writable_mounts_cannot_be_silently_verified(observations):
+    report = observations[0][1]
+    unprobeable = [r for r in report["mounts"] if r["canary"] == "UNPROBEABLE"]
+    assert unprobeable, "control needs actual unprobeable writable mounts"
+    assert _verdict(report)["verified"] is False, unprobeable
+
+
+def test_real_shared_host_mount_must_override_old_refused_channels(observations):
+    report = observations[4][1]
+    assert next(r for r in report["mounts"] if r["target"] == "/shared")["seen"]
+    assert _verdict(report)["verified"] is False
+
+
+def admissible_contract_evidence():
+    """Synthetic COMPLETE baseline for the proposed checkpoint-3 validator API.
+
+    This is not a claim about the real rig: its unprobeable mounts are unsafe.
+    validate_container_evidence(report, *, expected) must return a dict with
+    status PASS/BLOCKED and reasons containing the codes tested below. The raw
+    inventory, parsed inventory and runtime-declared mounts must reconcile.
+    Pseudo-filesystems here are read-only; none is exempt from reconciliation.
+    """
+    raw = ("1 0 0:1 / / ro - overlay overlay ro\n2 1 0:2 / /tmp rw - tmpfs tmpfs rw\n"
+           "3 1 0:3 / /proc ro - proc proc ro\n4 1 0:4 / /source ro - ext4 ext4 ro\n"
+           "5 1 0:5 / /venv ro - ext4 ext4 ro\n")
+    mounts = [dict(id=str(i), target=target, source=fs, fstype=fs, root="/",
+                   options=[mode], optional=[], super_options=[mode],
+                   canary="WRITTEN" if mode == "rw" else "READ_ONLY",
+                   seen=None)
+              for i, target, fs, mode in [(1,"/","overlay","ro"),(2,"/tmp","tmpfs","rw"),(3,"/proc","proc","ro"),
+                                           (4,"/source","ext4","ro"),(5,"/venv","ext4","ro")]]
+    expected = dict(source_sha="1" * 40, image_digest=IMAGE.split("@")[1],
+                    image_id="2d2651e4d002c518bb669cb044209897ff02e33318a4b92ac185cf23be33f532",
+                    podman_version="4.9.3", containerfile_sha256="2" * 64,
+                    launcher_sha256="3" * 64, probe_sha256="4" * 64,
+                    writable_targets=["/tmp"], source_path="/source", venv_path="/venv")
+    report = dict(schema="checkpoint2.container_evidence.contract/1", provenance=dict(expected),
+                  mountinfo=raw, mounts=mounts,
+                  runtime_mounts=[dict(target=r["target"], writable="rw" in r["options"],
+                                      private=True, backing="host" if r["target"] in ("/source", "/venv")
+                                      else "container") for r in mounts],
+                  container_ids=["a" * 64, "b" * 64, "c" * 64], restart_refused=True,
+                  actual_image_digest=expected["image_digest"], actual_image_id=expected["image_id"],
+                  writes=dict(source="READ_ONLY",venv="READ_ONLY"),
+                  status={**{k:"0" for k in ("CapInh","CapPrm","CapEff","CapBnd","CapAmb")},"NoNewPrivs":"1"},
+                  network=dict(host_listener="REFUSED", external="REFUSED", positive_control="REACHED"),
+                  paths={k:"/tmp/"+k for k in ("HOME","workdir","TMPDIR","XDG_CACHE_HOME","PYTHONPYCACHEPREFIX")},
+                  canaries=dict(written_a=["/tmp"], observed_b=[], observed_restart=[],
+                                shared_control="REACHED", tokens={"/tmp":"5" * 64}),
+                  argv=["podman","run","--rm","--read-only","--network=none","--cap-drop=ALL",
+                        "--security-opt=no-new-privileges","--userns=keep-id",IMAGE,"python3","probe.py"])
+    return report, expected
+
+
+def validator_contract():
+    fn = getattr(isolation, "validate_container_evidence", None)
+    assert callable(fn), (
+        "MISSING_VALIDATION_CONTRACT: isolation.validate_container_evidence(report, expected=...) "
+        "must reconcile inventory and runtime identities and return PASS/BLOCKED with named reasons; "
+        "old channel verdict strings cannot establish this contract"
+    )
+    return fn
+
+
+def test_complete_admissible_evidence_is_accepted():
+    report, expected = admissible_contract_evidence()
+    result = validator_contract()(report, expected=expected)
+    assert result == {"status":"PASS", "reasons":[]}, result
+
+
+@pytest.mark.parametrize("mutation,reason", [
+    ("missing_mount","MOUNT_INVENTORY_MISMATCH"), ("duplicate_mount","MOUNT_INVENTORY_MISMATCH"),
+    ("windows_writable","WINDOWS_WRITABLE_MOUNT"), ("host_writable","HOST_WRITABLE_MOUNT"),
+    ("shared_propagation","SHARED_WRITABLE_MOUNT"), ("undeclared_writable","UNDECLARED_WRITABLE_MOUNT"),
+    ("unprobeable","UNPROBEABLE_WRITABLE_MOUNT"), ("image_mismatch","IMAGE_DIGEST_MISMATCH"),
+    ("reused_container","CONTAINER_REUSED"), ("writable_source","SOURCE_WRITABLE"),
+    ("writable_venv","VENV_WRITABLE"), ("nonzero_caps","NONZERO_CAPABILITIES"),
+    ("nnp_off","NO_NEW_PRIVILEGES_MISSING"), ("network_reached","NETWORK_REACHED"),
+    ("shared_home","PATH_OUTSIDE_PRIVATE_MOUNTS"), ("shared_cache","PATH_OUTSIDE_PRIVATE_MOUNTS"),
+    ("canary_leak","CROSS_CARD_CANARY_REACHED"), ("missing_probe","CANARY_COVERAGE_INCOMPLETE"),
+    ("failed_positive_control","CANARY_CONTROL_FAILED"), ("source_mismatch","SOURCE_IDENTITY_MISMATCH"),
+])
+def test_evidence_mutation_has_specific_rejection(mutation, reason):
+    report, expected = admissible_contract_evidence()
+    row = report["mounts"][1]
+    if mutation == "missing_mount": report["mounts"].remove(row)
+    elif mutation == "duplicate_mount": report["mounts"].append(dict(row))
+    elif mutation == "windows_writable": row.update(fstype="9p", source="C:")
+    elif mutation == "host_writable": report["runtime_mounts"][1]["backing"] = "host"
+    elif mutation == "shared_propagation": row["optional"] = ["shared:42"]
+    elif mutation == "undeclared_writable": expected["writable_targets"] = []
+    elif mutation == "unprobeable": row["canary"] = "UNPROBEABLE"
+    elif mutation == "image_mismatch": report["actual_image_digest"] = "sha256:" + "0" * 64
+    elif mutation == "reused_container": report["container_ids"][1] = report["container_ids"][0]
+    elif mutation in ("writable_source","writable_venv"): report["writes"][mutation.split("_")[1]] = "WRITABLE"
+    elif mutation == "nonzero_caps": report["status"]["CapEff"] = "1"
+    elif mutation == "nnp_off": report["status"]["NoNewPrivs"] = "0"
+    elif mutation == "network_reached": report["network"]["host_listener"] = "REACHED"
+    elif mutation == "shared_home": report["paths"]["HOME"] = "/home/operator"
+    elif mutation == "shared_cache": report["paths"]["XDG_CACHE_HOME"] = "/home/operator/cache"
+    elif mutation == "canary_leak": report["canaries"]["observed_b"] = ["/tmp"]
+    elif mutation == "missing_probe": report["canaries"]["written_a"] = []
+    elif mutation == "failed_positive_control": report["canaries"]["shared_control"] = "REFUSED"
+    else: report["provenance"]["source_sha"] = "0" * 40
+    result = validator_contract()(report, expected=expected)
+    assert result["status"] == "BLOCKED" and reason in result["reasons"], result
+
+
