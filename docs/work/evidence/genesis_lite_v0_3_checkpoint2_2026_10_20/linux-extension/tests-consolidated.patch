+"""Checkpoint 2: regression specifications for the unresolved D5/N-1 boundary.
+
+These tests exercise the CURRENT launcher, deployment checker and state probe.
+They do not import a hypothetical container implementation or require Podman.
+Tool discovery is stubbed deliberately: missing executables cannot explain red
+assertions. Command tests establish requested configuration, NOT runtime isolation.
+Runtime mount inventories, kernel flags and container A/B evidence remain owed
+in checkpoint 4. No formal worlds are generated by this module.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import pathlib
+import secrets
+import subprocess
+import sys
+
+import pytest
+
+from benchmarks.genesis_lite.v0_3 import deployment_attacks as attacks
+from benchmarks.genesis_lite.v0_3 import formal, isolation
+from benchmarks.genesis_lite.v0_3.registry import AttemptRegistry
+
+
+@pytest.fixture
+def launcher(monkeypatch):
+    # Only host discovery is replaced; argv/describe are the production methods.
+    monkeypatch.setattr(isolation, "available", lambda: True)
+    monkeypatch.setattr(isolation.shutil, "which", lambda tool: f"/usr/bin/{tool}")
+    return isolation.NamespaceLauncher(("/home/forge/source", "/home/forge/venv"))
+
+
+def test_launch_uses_a_fresh_container_without_shell_construction(launcher):
+    inner = ["/home/forge/venv/bin/python", "-I", "host.py", "literal;argument"]
+    argv = launcher.argv(inner, "/tmp/card-a")
+    assert pathlib.PurePosixPath(argv[0]).name == "podman", argv[0]
+    assert "run" in argv and not {"exec", "start", "/bin/sh", "-c"} & set(argv)
+    assert argv[-len(inner):] == inner
+
+
+@pytest.mark.parametrize("flag", [
+    "--rm",
+    "--read-only",
+    "--network=none",
+    "--cap-drop=ALL",
+    "--security-opt=no-new-privileges",
+    "--userns=keep-id",
+])
+def test_container_security_options_are_explicit(launcher, flag):
+    argv = launcher.argv(["python", "-I", "host.py"], "/tmp/card-a")
+    assert flag in argv, f"required container launch option absent: {flag}"
+
+
+@pytest.mark.parametrize("target", ["/tmp", "/var/tmp", "/run", "/dev/shm"])
+def test_each_required_writable_mount_is_explicit_private_tmpfs(launcher, target):
+    argv = launcher.argv(["python", "-I", "host.py"], "/tmp/card-a")
+    specifications = [
+        argv[i + 1] for i, value in enumerate(argv[:-1]) if value == "--tmpfs"
+    ] + [value.partition("=")[2] for value in argv if value.startswith("--tmpfs=")]
+    assert any(value.split(":", 1)[0] == target for value in specifications), (
+        f"{target} has no explicit per-container tmpfs declaration"
+    )
+
+
+def test_source_and_venv_bind_mounts_are_explicitly_read_only(launcher):
+    argv = launcher.argv(["python", "-I", "host.py"], "/tmp/card-a")
+    mounts = [
+        argv[i + 1] for i, value in enumerate(argv[:-1]) if value in ("--mount", "--volume", "-v")
+    ] + [value.partition("=")[2] for value in argv if value.startswith(("--mount=", "--volume="))]
+    for source in ("/home/forge/source", "/home/forge/venv"):
+        assert any(source in mount and (
+            "readonly" in mount.split(",") or "ro" in mount.rsplit(":", 1)[-1].split(",")
+        ) for mount in mounts), f"no read-only container bind for {source}"
+
+
+def test_launch_pins_an_immutable_image_identity(launcher):
+    argv = launcher.argv(["python", "-I", "host.py"], "/tmp/card-a")
+    assert any("@sha256:" in value and len(value.rsplit("@sha256:", 1)[1]) == 64
+               for value in argv), "launch can proceed without an immutable image digest"
+
+
+def test_deployment_report_cannot_verify_without_mount_and_container_evidence():
+    # All old channels report REFUSED. That alone says nothing about an unprobed
+    # writable mount, image substitution, capabilities, or source/venv mount flags.
+    result = attacks.verify_deployment(
+        lambda spec: [f"{spec.rsplit(':', 1)[1]}:REFUSED:synthetic old-channel transcript"],
+        scan_findings=[],
+    )
+    assert result["verified"] is False, (
+        "accepted without complete mountinfo reconciliation, writable-mount canaries, "
+        "A/B container identities, image digest, runtime flags or launcher/probe provenance"
+    )
+
+
+@pytest.mark.parametrize("verdict", [attacks.REACHED, attacks.UNTESTABLE])
+def test_existing_negative_channel_controls_stay_blocking(verdict):
+    result = attacks.verify_deployment(
+        lambda spec: [f"{spec.rsplit(':', 1)[1]}:{verdict}:negative control"],
+        scan_findings=[],
+    )
+    assert result["verified"] is False
+
+
+def test_unavailable_runtime_is_refused_before_admission(monkeypatch):
+    monkeypatch.setattr(isolation, "available", lambda: False)
+    assert formal.deployment_problems()
+
+
+def test_runtime_launch_failure_is_detected_before_consuming_the_root(monkeypatch, tmp_path):
+    """Unlike the old test with an injected ['no unshare'] list, use the real
+    deployment checker, with successful tool discovery but failed process launch.
+    Empty plan + synthetic runner ensure this test cannot generate formal worlds.
+    """
+    monkeypatch.setattr(isolation, "available", lambda: True)
+    monkeypatch.setattr(isolation, "kept_paths", lambda: ("/home/forge/source", "/home/forge/venv"))
+    monkeypatch.setattr(isolation.shutil, "which", lambda tool: f"/usr/bin/{tool}")
+
+    def launch_denied(*args, **kwargs):
+        raise PermissionError("synthetic runtime denial after successful tool discovery")
+
+    monkeypatch.setattr(isolation.subprocess, "run", launch_denied)
+    monkeypatch.setattr(isolation.subprocess, "Popen", launch_denied)
+    # Bypass unrelated identity gates only; preserve real deployment and admission.
+    monkeypatch.setattr(formal, "preflight", lambda *args: [])
+    monkeypatch.setattr(formal, "committed_identity_problems", lambda *args: [])
+    monkeypatch.setattr(formal, "candidate_of", lambda doc: None)
+    monkeypatch.setattr(formal, "registered_arms", lambda: [])
+    monkeypatch.setattr(formal, "plan", lambda: [])
+    monkeypatch.setattr(formal, "harness_runner", lambda doc: lambda *a, **kw: {})
+    doc = {"formal": {"budget": {"total_hours": 1}}}
+    registry = AttemptRegistry(tmp_path / "operator-registry")
+    published, refusal = [], None
+    try:
+        formal.run_formal(
+            bytes(range(32)), doc, manifest={}, registry=registry,
+            publish=published.append, sink=lambda row: None,
+        )
+    except formal.FormalRefused as exc:
+        refusal = str(exc)
+    assert registry.entries() == [], "failed isolation consumed the one allowed root attempt"
+    assert published == []
+    assert refusal is not None, "runtime failure did not block pre-admission"
+
+
+def _probe_in_fresh_interpreter(temp_directory: pathlib.Path, marker: pathlib.Path | None = None) -> dict:
+    # Every invocation is a new process. Only tempfile location is controlled.
+    # PYTHONPATH is not assumed; import THIS checkout explicitly.
+    root = pathlib.Path(__file__).resolve().parents[2]
+    code = (
+        "import sys,tempfile,json,pathlib,hashlib;"
+        "sys.path[:0]=[sys.argv[1],sys.argv[1]+'/src'];"
+        "tempfile.tempdir=sys.argv[2];"
+        "from benchmarks.genesis_lite.v0_3.deployment_attacks import cross_card_state;"
+        "answer=cross_card_state({'universe_id':'synthetic-card'},None);"
+        "answer['visible_canary_sha256']=hashlib.sha256(pathlib.Path(sys.argv[3]).read_bytes()).hexdigest() "
+        "if len(sys.argv)>3 else None;"
+        "print(json.dumps(answer))"
+    )
+    result = subprocess.run(
+        [sys.executable, "-I", "-c", code, str(root), str(temp_directory)]
+        + ([str(marker)] if marker is not None else []),
+        check=True, capture_output=True, text=True, timeout=30,
+    )
+    return json.loads(result.stdout)
+
+
+def test_shared_probe_directory_positive_control_survives_process_restart(tmp_path):
+    temporary = tmp_path / "private-tmp"
+    temporary.mkdir()
+    first = _probe_in_fresh_interpreter(temporary)
+    second = _probe_in_fresh_interpreter(temporary)
+    restarted = _probe_in_fresh_interpreter(temporary)
+    assert first["rationale"].startswith("cross_card_state:REFUSED:")
+    assert second["rationale"].startswith("cross_card_state:REACHED:")
+    assert restarted["rationale"].startswith("cross_card_state:REACHED:")
+
+
+def test_private_tmp_is_not_evidence_that_other_writable_mounts_are_private(tmp_path):
+    """Model N-1 with two private TMP parents and a separately shared writable
+    directory. A cryptographic canary is readable by B and after restart; the
+    production probe must not issue REFUSED based solely on its TMP parent.
+    This is a filesystem counterexample, not a real Podman mount experiment.
+    """
+    shared = tmp_path / "shared-writable-mount"
+    shared.mkdir()
+    canary = secrets.token_bytes(32)
+    marker = shared / "canary"
+    marker.write_bytes(canary)
+    observed = []
+    for card in ("a", "b", "b-restart"):
+        temporary = tmp_path / card / "tmp"
+        temporary.mkdir(parents=True)
+        response = _probe_in_fresh_interpreter(temporary, marker)
+        observed.append(response["rationale"])
+        assert response["visible_canary_sha256"] == hashlib.sha256(canary).hexdigest()
+    assert all(not rationale.startswith("cross_card_state:REFUSED:") for rationale in observed), (
+        "probe certified REFUSED from private TMP while a shared writable canary "
+        f"remained readable across cards and restart: {observed}"
+    )
