+"""Bounded checkpoint-2 feasibility check; no canary or device writes."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+IMAGE = "localhost/forge-card@sha256:89847920916e46363fe52f7cecc3a2b937d34d6b355dd3e8cc14527fe65a8261"
+ROOT = Path(__file__).resolve().parents[2]
+PROBE = Path(__file__).with_name("container_isolation_probe.py")
+
+
+@pytest.mark.skipif(sys.platform != "linux", reason="Linux-only bounded runtime experiment")
+def test_strict_readonly_inventory():
+    """An explicit unsafe inventory is an expected red; setup errors are errors."""
+    evidence = Path(os.environ["FORGE_CHECKPOINT_EVIDENCE"])
+    evidence.mkdir(parents=True, exist_ok=True)
+    transcript = {"source_sha": subprocess.check_output(
+        ["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip(),
+        "probe_sha256": hashlib.sha256(PROBE.read_bytes()).hexdigest()}
+    assert transcript["source_sha"] == "1cb5e187ef46ba2735fa292112a5e2bfd2334007"
+    argv = ["podman", "create", "--pull=never", "--rm", "--read-only",
+            "--read-only-tmpfs=false", "--security-opt=proc-opts=ro,nosuid,nodev,noexec",
+            "--network=none", "--ipc=private", "--cap-drop=ALL",
+            "--security-opt=no-new-privileges", "--userns=keep-id", "-i"]
+    for target in ("/tmp", "/var/tmp", "/run", "/dev/shm"):
+        argv += ["--tmpfs", target + ":rw,nosuid,nodev,mode=1777"]
+    argv += ["--volume", f"{ROOT}:/source:ro", "--volume", f"{sys.prefix}:/venv:ro",
+             "--workdir", "/tmp", "--env", "HOME=/tmp/home", "--env", "TMPDIR=/tmp",
+             "--env", "XDG_CACHE_HOME=/tmp/cache", "--env", "PYTHONPYCACHEPREFIX=/tmp/pycache",
+             IMAGE, "python3", "-", json.dumps({"write_canaries": False})]
+    transcript["argv"] = argv
+    cid = None
+    try:
+        made = subprocess.run(argv, capture_output=True, text=True, timeout=30)
+        transcript["create"] = vars(made)
+        made.check_returncode()
+        cid = made.stdout.strip()
+        inspected = subprocess.run(["podman", "inspect", cid], capture_output=True,
+                                   text=True, timeout=10)
+        inspected.check_returncode()
+        transcript["inspect"] = json.loads(inspected.stdout)
+        done = subprocess.run(["podman", "start", "--attach", "--interactive", cid],
+                              input=PROBE.read_text(), capture_output=True, text=True, timeout=30)
+        transcript["start"] = vars(done)
+        done.check_returncode()
+        report = json.loads(done.stdout)
+        transcript["report"] = report
+        writable = [r for r in report["mounts"] if "rw" in r["options"]]
+        transcript["writable_inventory"] = writable
+        required = {"/tmp", "/var/tmp", "/run", "/dev/shm"}
+        # Per-mount ro is authoritative for view writeability; superblock rw
+        # does not make an ro bind writable.
+        remaining = [r for r in writable if r["target"] not in required]
+        transcript["remaining_strict_blockers"] = remaining
+        assert not remaining, [
+            (r["id"], r["target"], r["fstype"], r["options"]) for r in remaining]
+    finally:
+        if cid:
+            cleanup = subprocess.run(["podman", "rm", "--force", "--ignore", cid],
+                                     capture_output=True, text=True, timeout=15)
+            transcript["cleanup"] = vars(cleanup)
+        (evidence / "readonly-runtime.json").write_bytes(
+            (json.dumps(transcript, indent=2, sort_keys=True) + "\n").encode())
+        if cid:
+            cleanup.check_returncode()
