+        argv += ["--volume","/repo:/source:ro","--volume","/venv-host:/venv:ro","--workdir","/tmp"]
+        for k,v in paths.items(): argv += ["--env",k+"="+v]
+        argv += ["localhost/forge-card@"+IMAGE,"python3","probe.py"]
+        canaries=[]
+        for i,t in enumerate(PRIVATE):
+            mid=rows[4+i]["id"]
