+def raw_mounts(rows):
+    return "".join(" ".join([r["id"],r["parent"],r["device"],escape(r["root"]),escape(r["target"]),
+                            ",".join(r["options"]),*r["optional"],"-",r["fstype"],escape(r["source"]),
+                            ",".join(r["super_options"])])+"\n" for r in rows)
+
