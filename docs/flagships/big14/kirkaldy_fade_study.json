 "deviations_from_preregistration": [
  {
   "decided": "after reading the archive structure and throughput columns of Expt 5, before any capacity value (PROGRESS, 2026-10-09); Expt 4's structure was not inspected before the run",
   "effect": "the last RPT of every cell is skipped: the most-aged point, where a knee would show; this biases TOWARD MET",
   "rule": "an RPT is placed on the per-cycle rows where their cumulative charge + discharge is nearest the RPT file's own 'Charge Throughput [A h]'; the discharge charge up to that row is the throughput; an RPT that does not align within 10.0 A h is skipped and never estimated",
   "why": "the per-cycle numbering restarts per set and runs through cycler fault rows, so it cannot place an RPT"
  },
  {
   "decided": "with the code, before any capacity value",
   "effect": "none known",
   "rule": "capacity is the 'C/10 Capacity [mA h]' column of the processed RPT summary",
   "why": "the pre-registration names 'the discharge capacity of each RPT capacity check, as the processed summary states it' but no column; C/10 is the slow capacity check the dataset's own example notebook plots as capacity"
  },
  {
   "decided": "with the code, before any capacity value",
   "effect": "none on the criteria; guards against a local minimum",
   "rule": "the fit is started from four activation energies (5, 30, 60, 120 kJ/mol) and the lowest cost is kept",
   "why": "the pre-registration fixes ordinary least squares and the bounds, not the optimiser"
  },
  {
   "decided": "after the first run, on review finding M2; the outcome is NOT MET either way",
   "effect": "moves both criteria AWAY from MET",
   "rule": "the reference RPT (RPT 0, where fade is 0 by definition and the prediction is 0 for any parameters) is excluded from C1 and C2; the values with it included are reported beside them",
   "why": "it is the normalisation, not a prediction; including it scales RMSE by sqrt((n-k)/n) and the bias by (n-k)/n toward MET"
  },
  {
   "decided": "checked after the first run, on review finding L3; recorded, not changed",
   "effect": "the holdout throughput is gross, not net, discharge",
   "rule": "for Expt 4 the per-cycle 'Discharge Capacity [A h]' is GROSS discharge charge of the drive cycle (it exceeds both the constant-current charge and the cell capacity per cycle, e.g. 5.87 vs 3.17 A h at cycle 0)",
   "why": "the pre-registration says 'cumulative discharge charge'; gross discharge charge is what the column holds"
  }
 ],
