    "negative": "CROSS_CELL_NOT_SUPPORTED",
    "positive": "CROSS_CELL_SUPPORTED",
    "refusal_condition": "as within-cell; OUT_OF_DOMAIN also when a held-out unit was a calibration unit",
    "required_evidence": "as within-cell, for a held-out set whose units are disjoint from the calibration units"
   },
   "IDENTIFIABILITY": {
    "applicability_scope": "the declared family, the calibration set's design, and the declared parameter bounds",
    "axis": "IDENTIFIABILITY",
    "meaning": "every requested LATENT_PARAMETER of the declared family is determined by the calibration observations (IDENTIFIABLE), or at least one is not (NOT_IDENTIFIABLE)",
    "negative": "NOT_IDENTIFIABLE",
    "positive": "IDENTIFIABLE",
    "refusal_condition": "REPRESENTATION_UNAVAILABLE: the family cannot be bound to declared roles or a requested parameter is not a declared LATENT_PARAMETER; INSUFFICIENT_EVIDENCE: full rank but no declared noise, or a weakly identified ridge (REVIEW)",
    "required_evidence": "the residual Jacobian of the bound family at the calibrated estimate; IDENTIFIABLE also needs a declared measurement noise, from which the local covariance is classified by the frozen V1 identifiability rule (engcore.hybrid_uq.identifiability); a rank-deficient Jacobian decides NOT_IDENTIFIABLE without one"
   },
   "MODEL_ADEQUACY": {
    "applicability_scope": "the declared family on the calibration set",
    "axis": "MODEL_ADEQUACY",
    "meaning": "the calibrated declared family describes the calibration data within the declared adequacy bar (or, with no bar, within the declared measurement noise)",
    "negative": "MODEL_INADEQUATE",
    "positive": "MODEL_ADEQUATE",
    "refusal_condition": "REPRESENTATION_UNAVAILABLE: the family cannot be bound; INSUFFICIENT_EVIDENCE: neither a bar nor a noise is declared, or the fit fails",
    "required_evidence": "calibration residuals of the best fit, compared with a declared bar (rmse and p95) or with a declared noise (chi-square at 0.999)"
   },
   "MODEL_DISCREPANCY": {
    "applicability_scope": "the declared family on the calibration set, at the stated resolution",
    "axis": "MODEL_DISCREPANCY",
    "meaning": "the calibrated family's residuals show structured model-form error beyond the declared measurement noise (PRESENT), or no discrepancy is resolved above it (UNRESOLVED; never 'zero')",
    "negative": "MODEL_DISCREPANCY_PRESENT",
    "positive": "MODEL_DISCREPANCY_UNRESOLVED",
    "refusal_condition": "REPRESENTATION_UNAVAILABLE: the family cannot be bound; INSUFFICIENT_EVIDENCE: no declared noise and no structure resolved (compatibility cannot be shown without a declared noise)",
    "required_evidence": "residual chi-square against a declared noise and/or lag-1 residual autocorrelation against a declared independence of the measurement noise"
   },
   "WITHIN_CELL_GENERALIZATION": {
    "applicability_scope": "calibration units only, inside the declared applicability domain",
    "axis": "WITHIN_CELL_GENERALIZATION",
    "meaning": "the calibrated family predicts held-out data of the SAME unit(s) within the declared acceptance bar",
    "negative": "WITHIN_CELL_NOT_SUPPORTED",
    "positive": "WITHIN_CELL_SUPPORTED",
    "refusal_condition": "INSUFFICIENT_EVIDENCE: no such set or no bar; OUT_OF_DOMAIN: a held-out trajectory leaves the declared domain or belongs to another unit; REPRESENTATION_UNAVAILABLE: the family cannot be bound",
    "required_evidence": "held-out prediction error of the calibrated family against the declared bar, after every held-out trajectory is shown inside the declared applicability domain"
   }
