          "case_id": "U00204",
          "previous_expected_verdict": "NOT_SUPPORTED",
          "new_expected_verdict": "SUPPORTED",
          "previous_label": "inconsistent_inputs",
          "label": "valid",
          "previous_declared_catcher": "thermal runaway",
          "declared_catcher": "",
          "previous_reason": "alpha = 0.05 /K: the electro-thermal loop does not contract. A design that runs away is a finding about the design, and belongs in the report rather than in an exception.",
          "reason": "alpha = +0.05 /K is a positive temperature coefficient, which is self-limiting: resistance rises with temperature and dissipation falls. Integrating C dT/dt = V^2/R(T) - hA (T - T_amb) from the declared initial state rises monotonically to a stable equilibrium at 355.8326 K, where the fixed-point map has |f'| = 0.853 < 1. Every declared limit is clear by a wide margin: 0.31 of the 1163.530 K operating ceiling, 0.18 of the 1963.530 K melting point, 1.356 W against a 10.861 W rating. This design does not run away.",
          "defect_family": "runaway",
          "independent_violation": false,
          "violated_at_adjudication": [],
